# Injected automatically by the Upstash Redis integration in Vercel Marketplace
# (The code accepts either UPSTASH_REDIS_REST_* or KV_REST_API_*)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Manually configured environment variables
ADMIN_PIN=            # Minimum 8 characters
SESSION_SECRET=       # Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=      # Generate with: openssl rand -hex 16 (appended to Kindle URL: ?k=...)
CRON_SECRET=          # Generate with: openssl rand -hex 16 (sent by Vercel as Bearer token to cron)
